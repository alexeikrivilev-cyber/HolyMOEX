# HolyMOEX GitLab deployment example.
# Organizers provide SANDBOX_API_KEY at deployment time.
# Keep real secrets in GitLab CI/CD Variables or server env, never in git.

APP_ENV=production
SYSTEM_MODE=automatic_live_trading
RUN_MODE=live_trading
DATA_DIR=/data

SANDBOX_API_KEY=provided_by_organizers
POLZA_API_KEY=put_in_gitlab_ci_variables

SAFE_LIVE_SUBMIT=false
LIVE_READINESS_PASSED=false
ARENA_GO_SANDBOX=true
ARENA_GO_SHORTS_ALLOWED=false
DECISION_ALLOW_SHORT_SELLING=false
DECISION_ALLOW_LONG_TO_SHORT_FLIP=false
ALLOW_ARENA_GO_TOKEN_FALLBACK=false

POSTGRES_DB=moex_agent
POSTGRES_USER=moex_agent
POSTGRES_PASSWORD=change_me_if_external
HOLYMOEX_USE_EXTERNAL_DATABASE=false
DATABASE_URL=
